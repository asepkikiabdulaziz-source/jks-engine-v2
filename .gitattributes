# Normalize line endings to LF in repo, checkout as-is on Windows
* text=auto eol=lf

# Force LF for specific file types
*.ts    text eol=lf
*.tsx   text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf

# Binary files — never touch line endings
*.xlsx  binary
*.png   binary
*.jpg   binary
*.ico   binary
