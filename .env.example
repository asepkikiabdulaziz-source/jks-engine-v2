# ==============================================================================
# .env.example — template onboarding (TANPA nilai rahasia). Salin → .env / set di
# dashboard host. JANGAN commit nilai aslinya (.env & .env.local sudah gitignored).
# ==============================================================================

# ── Frontend (Vite) — di-inline saat `npm run build` (build-time) ─────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Deploy 1-container: KOSONGKAN → frontend memanggil engine same-origin.
# Dev (engine terpisah dari Vite): set ke http://localhost:8000
VITE_ENGINE_URL=

# ── Engine (FastAPI) — runtime ────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key (Supabase > Settings > API). Bypass RLS — rahasia, host-only.
SUPABASE_SERVICE_KEY=<service-role-key>
# CORS: hanya relevan bila frontend di origin BERBEDA dari engine.
# Deploy 1-container: abaikan (default localhost cukup, tak terpakai).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
