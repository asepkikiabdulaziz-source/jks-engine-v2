# ==============================================================================
# .env.example — template onboarding (TANPA nilai rahasia). Salin → .env / set di
# dashboard host. JANGAN commit nilai aslinya (.env & .env.local sudah gitignored).
# ==============================================================================

# ── Dev lokal (`npm run dev`) — frontend Vite membaca ini via import.meta.env ──
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
# Dev: engine FastAPI terpisah dari Vite → set ke http://localhost:8000
VITE_ENGINE_URL=http://localhost:8000

# ── Deploy 1-container (RUNTIME) — FastAPI menyuntik ini ke frontend (__ENV__) ─
# Saat deploy, set yang INI (bukan VITE_*). Build image TIDAK butuh build-arg,
# jadi Cloud Run/Render/Railway bisa "deploy dari git" tanpa konfigurasi build.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>                   # publik (dikirim ke browser)
SUPABASE_SERVICE_KEY=<service-role-key>        # RAHASIA — bypass RLS, host-only
# ENGINE_URL: kosongkan → frontend memanggil engine same-origin (1-container).
ENGINE_URL=
# CORS: hanya relevan bila frontend beda origin dari engine. 1-container: abaikan.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
